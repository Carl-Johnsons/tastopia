<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseContractReference>true</UseContractReference>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="ExtensionTypes\**" />
    <EmbeddedResource Remove="ExtensionTypes\**" />
    <None Remove="ExtensionTypes\**" />
  </ItemGroup>

  <!-- ═══════════════ Application Dependencies ═══════════════ -->
  <ItemGroup>
    <!-- ◆ Cloudinary -->
    <PackageReference Include="CloudinaryDotNet" />

    <!-- ◆ CQRS -->
    <PackageReference Include="MediatR" />

    <!-- ◆ Other -->
		<PackageReference Include="AutoMapper" />
    <PackageReference Include="DotNetEnv" />
  </ItemGroup>

  <!-- Application use Domain for business logic -->
  <ItemGroup>
    <ProjectReference Include="..\UploadFileService.Domain\UploadFileService.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Files\Queries\" />
  </ItemGroup>

</Project>