void setBuildStatus(String message, String state, String context) {
  step([
      $class: 'GitHubCommitStatusSetter',
      reposSource: [$class: 'ManuallyEnteredRepositorySource',
                            url: 'https://github.com/Carl-Johnsons/tastopia'],
      contextSource: [$class: 'ManuallyEnteredCommitContextSource', context: context],
      errorHandlers: [[$class: 'ChangingBuildStatusErrorHandler', result: 'UNSTABLE']],
      statusResultSource: [ $class: 'ConditionalStatusResultSource',
                            results: [[$class: 'AnyBuildResult', message: message, state: state]] ]
  ])
}

def ensureAIModel() {
  sh(label:'Ensuring AI model exist', script: '''
    mkdir -p ~/models
    if [ ! -f ~/models/convnext_224_f.model.keras ]; then
      echo "Downloading model..."
      aws s3 cp s3://tastopia-ingredient-predict-model/convnext_224_f.model.keras ~/models \
       --endpoint-url=${R2_BUCKET_ENDPOINT}
    else
      echo "Model already exists, skipping download."
    fi
  ''')
}

def ensureSecret() {
  sh(label: 'Ensuring that Infisical token is present...',
    script: "echo 'INFISICAL_TOKEN=${INFISICAL_TOKEN}' > .env.local")
  sh(label: 'Showing .env.local (sanitized)...', script: 'sed \'s/=.*/=******/\' < .env.local')
  sh(label: 'Pulling env files...', script: "./scripts/env/pull-env.sh ${params.DEPLOY_ENV}")
}

def ensureK8sCluster() {
  sh(label: 'Ensuring that Kubernetes cluster is up...', script: '''
    if minikube status | grep -q Stopped; then
      echo Kubernetes cluster is not running
      echo Starting the cluster...
      minikube start --cpus='4'
    fi

    if minikube status | grep -q Stopped; then
      echo 'ERROR: Kubernetes cluster failed to start'
      exit 1
    fi

    echo Kubernetes cluster is online
  ''')
}

def deploy() {
  if (!params.DEPLOY_SERVICES) {
    echo 'Nothing built. Cancel deployment!'
    return
  }
  ensureAIModel()
  ensureSecret()
  ensureK8sCluster()

  sh(
    label: 'Running K8s deploy script...',
    script: "./scripts/k8s/deploy.sh -e ${params.DEPLOY_ENV} ${params.DEPLOY_SERVICES}"
  )
}

def serviceStatusCheck() {
  if (!params.DEPLOY_SERVICES) {
    return
  }

  def deployments = sh(
    label: 'Getting deployment list for health checking...',
    script: 'kubectl get deployments -o name --no-headers',
    returnStdout: true
  ).trim().split('\n')

  for (d in deployments) {
    sh(label: "Checking rollout status for ${d}...", script: """
      kubectl rollout status ${d} --timeout=5m || {
        kubectl logs "${d}";
        exit 1;
  }
    """)
}
}

def checkoutBranch() {
  def BRANCH = params.BUILD_BRANCH_NAME?.trim()

  if (!BRANCH) {
    checkout scm
    return
  }

  checkout scmGit(branches: [[name: "*/${BRANCH}"]])
}

pipeline {
  agent { label 'deploy' }

  options {
    skipDefaultCheckout()
  }

  environment {
    INFISICAL_TOKEN = credentials('infisical-token')
    R2_BUCKET_ENDPOINT = credentials('tastopia-r2-bucket-endpoint')
  }

  parameters {
    string(
      name: 'DEPLOY_SERVICES',
      defaultValue: '',
      description: 'Space-separated list of services to deploy (example: "consul rabbitmq mongo")'
    )
    
    string(
      name: 'BUILD_BRANCH_NAME',
      defaultValue: '',
      description: 'The github branch to run script on'
    )

    string(
      name: 'DEPLOY_ENV',
      defaultValue: 'staging',
      description: 'The environment to run the deploy script with. Could be either "staging" or "production"'
    )
  }

  stages {
    stage('Checkout SCM') {
      steps {
        checkoutBranch()
      }
    }

    stage('Service Deployment') {
      steps {
        script {
            setBuildStatus('Begin Deployment...', 'PENDING', 'jenkins/ci/deployment')
            deploy()
        }
      }
    }
    stage('Service Status check') {
      steps {
        script {
            serviceStatusCheck()
        }
      }

      post {
        success {
          setBuildStatus('Deployment succeeded', 'SUCCESS', 'jenkins/ci/deployment')
        }

        failure {
          setBuildStatus('Deployment failed', 'FAILURE', 'jenkins/ci/deployment')
        }
      }
    }
  }
}
