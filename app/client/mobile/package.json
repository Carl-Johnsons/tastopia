    "next-auth": "^5.0.0-beta.25",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.54.2",
    "react-i18next": "^15.2.0",
    "react-native": "0.86.3",
    "react-native-draggable-flatlist": "^4.0.1",
