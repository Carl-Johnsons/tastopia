<Project Sdk="Microsoft.NET.Sdk.Web">
  <!--
		This is a workaround for Reinforced.Typing to compile and generate typescript without corrupt entire project
		Ref: https://github.com/reinforced/Reinforced.Typings/issues/231
	-->
  <Target Name="CompileTypeScript" />

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>5fbd38f4-9da2-4a02-a5cd-d8fd83de54ff</UserSecretsId>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    <DockerfileContext>..\..\..</DockerfileContext>
    <OutputType>Exe</OutputType>
    <UseContractReference>true</UseContractReference>
  </PropertyGroup>

  <!-- ═══════════════ API Dependencies ═══════════════ -->
  <ItemGroup>
    <!-- ◆ Identity -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />

    <!-- ◆ Swagger -->
    <PackageReference Include="Swashbuckle.AspNetCore" />

    <!-- ◆ TypeScript Generator -->
    <PackageReference Include="Microsoft.TypeScript.MSBuild">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Reinforced.Typings" />
  </ItemGroup>

  <!-- API Layer use Application and Infrastructure projects -->
  <ItemGroup>
    <ProjectReference Include="..\RecipeService.Application\RecipeService.Application.csproj" />
    <ProjectReference Include="..\RecipeService.Infrastructure\RecipeService.Infrastructure.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <DefaultItemExcludes>.git\**;$(DefaultItemExcludes)</DefaultItemExcludes>
  </PropertyGroup>
</Project>