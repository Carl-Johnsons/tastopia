{
  "name": "tastopia",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "dev": "npx expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "maestro test -e E2E_TEST_USERNAME=$E2E_TEST_USERNAME -e E2E_TEST_PASSWORD=$E2E_TEST_PASSWORD -e ENV=${ENV:-dev} -e GITHUB_RUN_ID=${GITHUB_RUN_ID:-} .maestro",
    "lint": "expo lint",
    "build:android": "npx expo prebuild --platform android",
    "build:ios": "npx expo prebuild --platform ios",
    "postinstall": "npx patch-package",
    "init-notification-service": "npx --yes eas-cli env:create --scope project --name GOOGLE_SERVICES_JSON --type file --value ./google-services.json --visibility secret --environment development --non-interactive --force",
    "package:android": "EAS_NO_VCS=1 npx --yes eas-cli build --profile simulator  --platform android --local",
    "pretty": "prettier --write \"./**/*.{js,jsx,mjs,cjs,ts,tsx,json}\""
  },
  "jest": {
    "preset": "jest-expo"
  },
  "dependencies": {
    "@expo/vector-icons": "^14.1.0",
    "@gorhom/bottom-sheet": "^5.0.6",
    "@hookform/resolvers": "^3.9.1",
    "@microsoft/signalr": "^8.0.7",
    "@react-native-async-storage/async-storage": "2.1.2",
    "@react-native-community/datetimepicker": "8.4.1",
    "@react-native-picker/picker": "2.11.1",
    "@react-navigation/native": "^7.0.0",
    "@reduxjs/toolkit": "^2.2.7",
    "@rneui/base": "^4.0.0-rc.7",
    "@rneui/themed": "^4.0.0-rc.8",
    "@shopify/react-native-skia": "v2.0.0-next.4",
    "axios": "^1.7.9",
    "date-fns": "^3.6.0",
    "expo": "~53.0.27",
    "expo-asset": "~11.1.7",
    "expo-auth-session": "~6.2.1",
    "expo-blur": "~14.1.5",
    "expo-clipboard": "~7.1.5",
    "expo-constants": "~17.1.8",
    "expo-crypto": "~14.1.5",
    "expo-dev-client": "~5.2.4",
    "expo-device": "~7.1.4",
    "expo-file-system": "~18.1.11",
    "expo-font": "~13.3.2",
    "expo-image": "~2.4.1",
    "expo-image-picker": "~16.1.4",
    "expo-linear-gradient": "~14.1.5",
    "expo-linking": "~7.1.7",
    "expo-notifications": "~0.31.5",
    "expo-router": "~5.1.11",
    "expo-sharing": "~13.1.5",
    "expo-speech": "~13.1.7",
    "expo-speech-recognition": "^1.1.1",
    "expo-splash-screen": "~0.30.10",
    "expo-status-bar": "~2.2.3",
    "expo-system-ui": "~5.0.11",
    "expo-web-browser": "~14.2.0",
    "i18next": "^23.12.2",
    "languagedetect": "^2.0.0",
    "moti": "^0.29.0",
    "nativewind": "^4.1.23",
    "next-auth": "^5.0.0-beta.25",
    "query-string": "^7.1.3",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-hook-form": "^7.54.2",
    "react-i18next": "^15.2.0",
    "react-native": "0.79.6",
    "react-native-draggable-flatlist": "^4.0.1",
    "react-native-fs": "^2.20.0",
    "react-native-gesture-handler": "~2.24.0",
    "react-native-image-viewing": "^0.2.2",
    "react-native-modal": "^13.0.1",
    "react-native-outside-press": "^1.2.2",
    "react-native-pager-view": "6.7.1",
    "react-native-purchases": "^10.10.2",
    "react-native-purchases-ui": "^10.10.2",
    "react-native-reanimated": "~3.17.4",
    "react-native-safe-area-context": "5.4.0",
    "react-native-screens": "~4.11.1",
    "react-native-svg": "15.11.2",
    "react-native-tab-view": "^4.0.5",
    "react-native-uuid": "^2.0.3",
    "react-native-vision-camera": "^4.6.3",
    "react-native-web": "~0.20.0",
    "react-query": "^3.39.3",
    "react-redux": "^9.1.2",
    "redux-persist": "^6.0.0",
    "yup": "^1.6.1"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@react-native/metro-babel-transformer": "^0.79.6",
    "@types/date-fns": "^2.6.0",
    "@types/jest": "^29.5.12",
    "@types/react": "~19.0.10",
    "@types/react-test-renderer": "^19.0.0",
    "@typescript-eslint/parser": "^7.17.0",
    "ajv": "^7.2.4",
    "eslint": "^8.57.0",
    "eslint-config-expo": "~9.2.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-import-resolver-typescript": "^3.6.1",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-tailwindcss": "^3.17.4",
    "expo-doctor": "^1.14.0",
    "jest": "^29.2.1",
    "jest-expo": "~53.0.14",
    "patch-package": "^8.0.0",
    "prettier": "^3.3.3",
    "prettier-plugin-tailwindcss": "^0.6.5",
    "react-native-svg-transformer": "^1.5.0",
    "react-test-renderer": "19.0.0",
    "tailwindcss": "^3.4.7",
    "typescript": "~5.8.3"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "listUnknownPackages": false,
        "exclude": [
          "react-native-fs",
          "@rneui/base",
          "@rneui/themed",
          "react-native-image-viewing",
          "react-native-outside-press",
          "redux-persist"
        ]
      }
    }
  },
  "private": true
}
