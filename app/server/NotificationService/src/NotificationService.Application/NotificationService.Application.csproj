<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseContractReference>true</UseContractReference>
  </PropertyGroup>
  <ItemGroup>
    <!-- ◆ CQRS -->
    <PackageReference Include="MediatR" />

    <!-- ◆ gRPC -->
    <PackageReference Include="Grpc.AspNetCore" />

    <!-- ◆ Other -->
    <PackageReference Include="AutoMapper" />
    <PackageReference Include="DotNetEnv" />
    <PackageReference Include="SmartFormat.NET" />
  </ItemGroup>

  <!-- Application use Domain for business logic -->
  <ItemGroup>
    <ProjectReference Include="..\NotificationService.Domain\NotificationService.Domain.csproj" />
  </ItemGroup>
</Project>