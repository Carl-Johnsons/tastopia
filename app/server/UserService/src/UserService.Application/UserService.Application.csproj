<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseContractReference>true</UseContractReference>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Admins\**" />
    <EmbeddedResource Remove="Admins\**" />
    <None Remove="Admins\**" />
  </ItemGroup>

  <!-- ═══════════════ Application Dependencies ═══════════════ -->
  <ItemGroup>
    <!-- ◆ CQRS -->
    <PackageReference Include="MediatR" />

    <!-- ◆ gRPC -->
    <PackageReference Include="Grpc.AspNetCore" />

    <!-- ◆ Other -->
    <PackageReference Include="AutoMapper" />
    <PackageReference Include="DotNetEnv" />
  </ItemGroup>

  <!-- Application use Domain for business logic -->
  <ItemGroup>
    <ProjectReference Include="..\UserService.Domain\UserService.Domain.csproj" />
  </ItemGroup>
</Project>