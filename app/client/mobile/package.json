    "eslint-plugin-tailwindcss": "^3.17.4",
    "expo-doctor": "^1.20.4",
    "jest": "^29.2.1",
    "jest-expo": "~57.0.5",
    "patch-package": "^8.0.0",
    "prettier": "^3.3.3",
    "prettier-plugin-tailwindcss": "^0.6.5",
    "react-native-svg-transformer": "^1.5.0",
    "react-test-renderer": "19.2.3",
    "tailwindcss": "^3.4.7",
    "typescript": "~6.0.3"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "react-native-fs"
        ]
      }
    }
  },
  "private": true
