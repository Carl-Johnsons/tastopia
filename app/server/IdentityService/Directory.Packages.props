<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <!-- ═══════════════ Shared Dependencies ═══════════════  -->

    <PackageVersion Include="DotNetEnv" Version="3.2.0" />

    <!-- ═══════════════ Domain Dependencies ═══════════════  -->

    <!-- ◆ Entity Framework Core -->
    <PackageVersion Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.13" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.13" />

    <!-- ◆ JSON -->
    <PackageVersion Include="Newtonsoft.Json" Version="13.0.4" />

    <!-- ◆ Message queue -->
    <!-- MassTransit version 9.x.x+ now require commercial license -->
    <PackageVersion Include="MassTransit.RabbitMQ" Version="8.5.11" />
    <PackageVersion Include="MassTransit" Version="8.5.11" />

    <!-- ◆ SignalR client  -->
    <PackageVersion Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.13" />

    <!-- ═══════════════ Infrastructure Dependencies ═══════════════ -->

    <!-- ◆ Database -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.13" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />

    <!-- ◆ IdentityServer -->
    <PackageVersion Include="Duende.IdentityServer.EntityFramework" Version="8.0.9" />

    <!-- ◆ Logging -->
    <PackageVersion Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageVersion Include="Serilog" Version="4.4.0" />

    <!-- ◆ Service discovery -->
    <PackageVersion Include="Consul" Version="1.7.14.1" />

    <!-- ═══════════════ Application Dependencies ═══════════════ -->

    <!-- ◆ CQRS -->
    <PackageVersion Include="MediatR" Version="14.2.0" />

    <!-- ◆ gRPC -->
    <PackageVersion Include="Grpc.AspNetCore" Version="2.84.0" />

    <!-- ◆ IdentityServer -->
    <PackageVersion Include="Duende.IdentityServer.AspNetIdentity" Version="8.0.9" />

    <!-- ◆ Other -->
    <PackageVersion Include="AutoMapper" Version="16.2.0" />

    <!-- ═══════════════ API Dependencies ═══════════════ -->

    <!-- ◆ Cache -->
    <PackageVersion Include="Microsoft.AspNetCore.DataProtection.StackExchangeRedis" Version="10.0.13" />

    <!-- ◆ EF Core Migration Tooling -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.13" />

    <!-- ◆ Identity -->
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.Google" Version="10.0.13" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.13" />
    <PackageVersion Include="Microsoft.AspNetCore.Diagnostics.EntityFrameworkCore" Version="10.0.13" />
    <PackageVersion Include="Microsoft.AspNetCore.Identity.UI" Version="10.0.12" />

    <!-- ◆ Swagger -->
    <PackageVersion Include="Swashbuckle.AspNetCore" Version="10.3.0" />

    <!-- ◆ TypeScript Generator -->
    <PackageVersion Include="Microsoft.TypeScript.MSBuild" Version="7.0.1" />
    <PackageVersion Include="Reinforced.Typings" Version="1.6.7" />

    <!-- ◆ Other -->
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.NewtonsoftJson" Version="10.0.13" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Razor.RuntimeCompilation" Version="10.0.13" />

    <!-- ═══════════════ Transitive packages ═══════════════ -->
    <PackageVersion Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.19.2" />
    <PackageVersion Include="Microsoft.IdentityModel.Protocols.OpenIdConnect" Version="8.19.2" />
    <PackageVersion Include="Microsoft.IdentityModel.Protocols" Version="8.19.2" />
    <PackageVersion Include="Microsoft.IdentityModel.Tokens" Version="8.19.2" />
    <PackageVersion Include="System.IdentityModel.Tokens.Jwt" Version="8.19.2" />

  </ItemGroup>
</Project>