<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>b649e23c-2992-418f-a64a-3421fd168585</UserSecretsId>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    <DockerfileContext>..\..</DockerfileContext>
    <UseContractReference>true</UseContractReference>
  </PropertyGroup>

  <ItemGroup>
    <!-- ◆ Cache -->
    <PackageReference Include="CacheManager.Serialization.Json" />
    <PackageReference Include="CacheManager.StackExchange.Redis" />

    <!-- ◆ Identity -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />

    <!-- ◆ Logging -->
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Serilog" />

    <!-- ◆ Ocelot -->
    <PackageReference Include="Ocelot" />
    <PackageReference Include="Ocelot.Cache.CacheManager" />
    <PackageReference Include="Ocelot.Discovery.Consul" />

    <!-- ◆ Swagger -->
    <PackageReference Include="MMLib.SwaggerForOcelot" />
    <PackageReference Include="Swashbuckle.AspNetCore.Swagger" />
    <PackageReference Include="Swashbuckle.AspNetCore" />

    <!-- ◆ Other -->
    <PackageReference Include="Microsoft.AspNetCore.Mvc.NewtonsoftJson" />
    <PackageReference Include="DotNetEnv" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="Config\production\ocelot.signalr.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>
</Project>