{
  "name": "tastopia",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "dev": "npx expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "maestro test -e E2E_TEST_USERNAME=$E2E_TEST_USERNAME -e E2E_TEST_PASSWORD=$E2E_TEST_PASSWORD -e ENV=${ENV:-dev} -e GITHUB_RUN_ID=${GITHUB_RUN_ID:-} .maestro",
    "lint": "expo lint",
    "build:android": "npx expo prebuild --platform android",
    "build:ios": "npx expo prebuild --platform ios",
    "postinstall": "npx patch-package",
    "init-notification-service": "npx --yes eas-cli env:create --scope project --name GOOGLE_SERVICES_JSON --type file --value ./google-services.json --visibility secret --environment development --non-interactive --force",
    "package:android": "EAS_NO_VCS=1 npx --yes eas-cli build --profile simulator  --platform android --local",
    "pretty": "prettier --write \"./**/*.{js,jsx,mjs,cjs,ts,tsx,json}\""
  },
  "jest": {
    "preset": "jest-expo"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@gorhom/bottom-sheet": "^5.0.6",
    "@hookform/resolvers": "^3.9.1",
    "@microsoft/signalr": "^8.0.7",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-native-picker/picker": "2.11.4",
    "@react-navigation/native": "^7.0.0",
    "@reduxjs/toolkit": "^2.2.7",
    "@rneui/base": "^4.0.0-rc.7",
    "@rneui/themed": "^4.0.0-rc.8",
    "@shopify/react-native-skia": "2.6.2",
    "axios": "^1.7.9",
    "date-fns": "^3.6.0",
    "expo": "^57.0.25",
    "expo-asset": "~57.0.18",
    "expo-auth-session": "~57.0.13",
    "expo-blur": "~57.0.3",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.19",
    "expo-crypto": "~57.0.3",
    "expo-dev-client": "~57.0.19",
    "expo-device": "~57.0.2",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-image": "~57.0.5",
    "expo-image-picker": "~57.0.20",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.11",
    "expo-notifications": "~57.0.21",
    "expo-router": "~57.0.23",
    "expo-sharing": "~57.0.22",
    "expo-speech": "~57.0.3",
