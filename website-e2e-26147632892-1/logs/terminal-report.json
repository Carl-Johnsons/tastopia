{
  "cypress/e2e/recipes-data.cy.ts": {
    "Recipes data exploration -> renders recipe data table and accepts search input": [
      {
        "type": "cy:command",
        "message": "visit\t/ -> 307: https://pr-257-tastopia-dev-dashboard.phenchua.dev/en",
        "severity": "success"
      },
      {
        "type": "cy:fetch",
        "message": "GET https://pr-257-tastopia-dev-dashboard.phenchua.dev/api/auth/session\nStatus: 200",
        "severity": "success"
      },
      {
        "type": "cy:command",
        "message": "contains\tbutton, /Sign in/i",
        "severity": "success"
      },
      {
        "type": "cy:command",
        "message": "click\t",
        "severity": "success"
      },
      {
        "type": "cy:fetch",
        "message": "POST https://pr-257-tastopia-dev-dashboard.phenchua.dev/en\nStatus: 303",
        "severity": "warning"
      },
      {
        "type": "cy:command",
        "message": "env\tE2E_TEST_USERNAME, E2E_TEST_PASSWORD, DUENDE_IDS6_ISSUER",
        "severity": "success"
      },
      {
        "type": "cy:command",
        "message": "location\torigin",
        "severity": "success"
      },
      {
        "type": "cy:fetch",
        "message": "GET https://pr-257-tastopia-dev-dashboard.phenchua.dev/api/auth/session\nStatus: 200",
        "severity": "success"
      },
      {
        "type": "cy:command",
        "message": "assert\texpected **https://pr-257-tastopia-dev-dashboard.phenchua.dev** to equal **https://pr-257-tastopia-dev-identity.phenchua.dev**\nActual: \t\"https://pr-257-tastopia-dev-dashboard.phenchua.dev\"\nExpected: \t\"https://pr-257-tastopia-dev-identity.phenchua.dev\"",
        "severity": "success"
      },
      {
        "type": "cy:command",
        "message": "page load\t--waiting for new page to load--",
        "severity": "error"
      }
    ]
  },
