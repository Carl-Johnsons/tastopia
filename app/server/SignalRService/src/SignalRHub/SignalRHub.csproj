<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>6f094a2b-8368-49cb-bf91-f5c6a965d335</UserSecretsId>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    <DockerfileContext>..\..\..</DockerfileContext>
    <UseContractReference>true</UseContractReference>
  </PropertyGroup>

  <ItemGroup>
    <!-- ◆ Identity -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />

    <!-- ◆ JSON -->
    <PackageReference Include="Newtonsoft.Json" />

    <!-- ◆ Logging -->
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Serilog" />

    <!-- ◆ Service discovery -->
    <PackageReference Include="Consul" />

    <!-- ◆ Other -->
    <PackageReference Include="DotNetEnv" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Protocols.NewtonsoftJson" />
  </ItemGroup>
</Project>