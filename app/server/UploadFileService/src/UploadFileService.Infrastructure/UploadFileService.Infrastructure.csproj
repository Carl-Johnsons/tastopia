<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseContractReference>true</UseContractReference>
  </PropertyGroup>

  <!-- ═══════════════ Infrastructure Dependencies ═══════════════ -->
  <ItemGroup>
    <!-- ◆ gRPC -->
    <PackageReference Include="Grpc.AspNetCore" />

    <!-- ◆ Logging -->
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Serilog" />

    <!-- ◆ Service discovery -->
    <PackageReference Include="Consul" />

    <!-- ◆ Other -->
    <PackageReference Include="DotNetEnv" />
  </ItemGroup>

  <!-- Domain dependency for domain models and rules -->
  <ItemGroup>
    <ProjectReference Include="..\UploadFileService.Domain\UploadFileService.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Persistence\Migrations\" />
  </ItemGroup>

</Project>