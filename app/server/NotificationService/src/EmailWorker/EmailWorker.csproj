<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>dotnet-EmailWorker-8f1c4e66-8128-4d9b-99cf-474c3138e4ca</UserSecretsId>
    <UseContractReference>true</UseContractReference>
  </PropertyGroup>

  <ItemGroup>
    <None Include="credentials.json" />
  </ItemGroup>

  <ItemGroup>

    <!-- ◆ Logging -->
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.AspNetCore" />

    <!-- Mail -->
    <PackageReference Include="Google.Apis.Auth" />
    <PackageReference Include="Google.Apis.Gmail.v1" />
    <PackageReference Include="MimeKit" />

    <!-- ◆ Message queue -->
    <PackageReference Include="MassTransit" />
    <PackageReference Include="MassTransit.RabbitMQ" />

    <!-- ◆ Other -->
    <PackageReference Include="DotNetEnv" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />

  </ItemGroup>
</Project>