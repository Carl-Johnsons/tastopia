void setBuildStatus(String message, String state, String context) {
  step([
      $class: 'GitHubCommitStatusSetter',
      reposSource: [$class: 'ManuallyEnteredRepositorySource',
                          url: 'https://github.com/Carl-Johnsons/tastopia'],
      contextSource: [$class: 'ManuallyEnteredCommitContextSource', context: context],
      errorHandlers: [[$class: 'ChangingBuildStatusErrorHandler', result: 'UNSTABLE']],
      statusResultSource: [ $class: 'ConditionalStatusResultSource',
                          results: [[$class: 'AnyBuildResult', message: message, state: state]] ]
  ])
}

def getChangedPaths() {
  def prev = env.GIT_PREVIOUS_SUCCESSFUL_COMMIT
  if (!prev) {
    echo 'No previous successful commit found, full rebuild.'
    return null
  }

  echo "Last git previous successful commit: ${prev}"
  def output = sh(
        script: "git diff --name-only ${prev} HEAD",
        returnStdout: true
    ).trim()

  if (output == '') return []
  return output.split('\n')
}

def detectServicesToBuild(changedFiles, services) {
  def buildList = []

  serviceFolders.each { service, folders ->
    def affected = changedFiles.any { files ->
      folders.any { folder -> file.startsWith(folder) }
    }

    if (affected) {
        buildList << service
    }
  }
  return buildList
}

def ensureEnv() {
  sh(label: 'Ensuring that Infisical token is present...',
     script: "echo 'INFISICAL_TOKEN=${INFISICAL_TOKEN}' > .env.local")
  sh(label: 'Showing .env.local (sanitized)...', script: 'sed \'s/=.*/=******/\' < .env.local')
  sh(label: 'Pulling env files...', script: './scripts/env/pull-env.sh')
}

def cleanUp() {
  sh(label: 'Clean up unused docker container...', script: 'docker container prune -f')
  sh(label: 'Clean up unused docker image...', script: 'docker image prune -a -f')
  sh(label: 'Clean up unused docker volume...', script: 'docker volume prune -f')
  sh(label: 'Clean up unused docker network...', script: 'docker network prune -f')
  sh(label: 'Clean up docker system ...', script: 'docker system prune -f')
}

def buildServices() {
  ensureEnv()

  def serviceFolders = [
    // 'website': [ 'website' ],
    'api-gateway': [ 'APIGateway' ],
    'signalr': [ 'SignalRService' ],
    'tracking-api': [ 'TrackingService' ],
    'upload-api': [ 'UploadFileService' ],
    'identity-api': [ 'IdentityService' ],
    'notification-api': [
      'NotificationService/src/NotificationService.API',
      'NotificationService/src/NotificationService.Application',
      'NotificationService/src/NotificationService.Domain',
      'NotificationService/src/NotificationService.Infrastructure'
    ],
    'recipe-api': [
      'RecipeService/src/RecipeService.API',
      'RecipeService/src/RecipeService.Application',
      'RecipeService/src/RecipeService.Domain',
      'RecipeService/src/RecipeService.Infrastructure',
    ],
    'user-api': [ 'UserService' ],
    // 'ingredient-predict-api': [ 'IngredientPredictService' ],
    // 'email-worker': [ 'NotificationService/src/EmailWorker' ],
    // 'sms-worker': [ 'NotificationService/src/SMSWorker' ],
    // 'push-notification-worker': [ 'NotificationService/src/PushNotificationWorker' ],
    // 'recipe-worker': [ 'RecipeService/src/RecipeWorker' ]
  ]

  def validServices = serviceFolders.keySet() as List

  def manualList = []
  if (params.BUILD_SERVICES) {
    manualList = params.BUILD_SERVICES
        .trim()
        .split(',')
        .each { s ->
          s = s.trim()
          if (s) {
            manualList << s
          }
        }
    def invalid = manualList.findAll { !validServices.contains(it) }

    if (!invalid.isEmpty()) {
      error "Invalid service name(s): ${invalid}. Valid values: ${validServices}"
    }
    echo "Manual override: building ${manualList}"
    runBuildScript(manualList)
    return
  }

  def changed = getChangedPaths()
  def filtered = []
  if (changed == null) {
    filtered = serviceFolders.keySet() as List
  } else {
    filtered = detectServicesToBuild(changed, serviceFolders)
  }

  if (filtered.isEmpty()) {
    echo 'No changed services. Nothing to build.'
    return
  }

  runBuildScript(filtered)
}

def runBuildScript(services) {
  sh(label: 'Publish share library...', script: '''
    dotnet publish --packages "$(pwd)/data/nuget" \
      -o ./app/server/Contract/Contract/Published \
      ./app/server/Contract/Contract
  ''')
  echo "Building ${services.join(' ')}" 
  sh(label: 'Building docker images...', script: "bash ./scripts/docker/build-services.sh ${services.join(' ')}")
  cleanUp()
}

pipeline {
  agent none

  environment {
    INFISICAL_TOKEN = credentials('infisical-token')
  }

  parameters {
    string(
      name: 'BUILD_SERVICES',
      defaultValue: '',
      description: 'Comma-separated list of services to build (override auto-detect)'
    )
  }

  stages {
    stage('Build service') {
      agent { label 'builder' }

      steps {
        script {
            setBuildStatus('Begin building services...', 'PENDING', 'jenkins/ci/build')
            buildServices()
        }
      }

      post {
        success {
          setBuildStatus('Deployment succeeded', 'SUCCESS', 'jenkins/ci/build')
        }

        failure {
          setBuildStatus('Deployment failed', 'FAILURE', 'jenkins/ci/build')
        }
      }
    }
  }
}
