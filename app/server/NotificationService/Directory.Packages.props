<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <!-- ═══════════════ Shared Dependencies ═══════════════ -->
    <PackageVersion Include="DotNetEnv" Version="3.2.0" />

    <!-- ═══════════════ Domain Dependencies ═══════════════  -->

    <!-- ◆ Entity Framework Core -->
    <PackageVersion Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.13" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.13" />
    <PackageVersion Include="MongoDB.EntityFrameworkCore" Version="10.0.4" />

    <!-- ◆ JSON -->
    <PackageVersion Include="Newtonsoft.Json" Version="13.0.4" />

    <!-- ◆ Message queue -->
    <PackageVersion Include="MassTransit.RabbitMQ" Version="8.5.11" />
    <PackageVersion Include="MassTransit" Version="8.5.11" />

    <!-- ◆ SignalR client  -->
    <PackageVersion Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.13" />

    <!-- ═══════════════ Infrastructure Dependencies ═══════════════ -->

    <!-- ◆ Database -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.13" />

    <!-- ◆ Logging -->
    <PackageVersion Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageVersion Include="Serilog" Version="4.4.0" />

    <!-- ◆ Service discovery -->
    <PackageVersion Include="Consul" Version="1.7.14.1" />

    <!-- ═══════════════ Application Dependencies ═══════════════ -->
    <!-- ◆ CQRS -->
    <PackageVersion Include="MediatR" Version="12.2.0" />

    <!-- ◆ gRPC -->
    <PackageVersion Include="Grpc.AspNetCore" Version="2.84.0" />

    <!-- ◆ Other -->
    <PackageVersion Include="AutoMapper" Version="16.2.0" />
    <PackageVersion Include="SmartFormat.NET" Version="3.6.1" />

    <!-- ═══════════════ API Dependencies ═══════════════ -->

    <!-- ◆ Identity -->
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.13" />

    <!-- ◆ Swagger -->
    <PackageVersion Include="Swashbuckle.AspNetCore" Version="10.3.0" />

    <!-- ◆ TypeScript Generator -->
    <PackageVersion Include="Microsoft.TypeScript.MSBuild" Version="7.0.1" />
    <PackageVersion Include="Reinforced.Typings" Version="1.6.7" />

    <!-- ═══════════════ Push notification worker Dependencies ═══════════════ -->
    <PackageVersion Include="Expo.Server.SDK" Version="1.0.2" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.13" />

    <!-- ═══════════════ Email worker Dependencies ═══════════════ -->
    <PackageVersion Include="Google.Apis.Auth" Version="1.77.0" />
    <PackageVersion Include="Google.Apis.Gmail.v1" Version="1.77.0.4295" />
    <PackageVersion Include="MimeKit" Version="4.18.1" />

    <!-- ═══════════════ Transitive package ═══════════════ -->
    <PackageVersion Include="Microsoft.IdentityModel.Abstractions" Version="8.19.2" />
    <PackageVersion Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.19.2" />
    <PackageVersion Include="Microsoft.IdentityModel.Logging" Version="8.19.2" />
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>
</Project>